# ══════════════════════════════════════════════════════════════
#  HEIST.EXE — Variables d'environnement
#  Copie ce fichier : cp .env.example .env
#  Ne commit JAMAIS le fichier .env  (déjà dans .gitignore)
# ══════════════════════════════════════════════════════════════

# ── Sécurité JWT ──────────────────────────────────────────────
# Clé secrète pour signer les tokens JWT des joueurs.
# OBLIGATOIRE — minimum 32 caractères, aléatoire.
# Génère une valeur sûre : python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-minimum-32-chars-random-string-here

# ── Clé API Admin ─────────────────────────────────────────────
# Requise pour accéder au panneau d'administration (/admin).
# Utilise une valeur longue et unique. Garde-la secrète.
ADMIN_KEY=change-me-strong-admin-key-here

# ── Base de données SQLite ────────────────────────────────────
# Chemin vers le fichier SQLite à l'intérieur du container.
# Ne pas modifier sauf si tu sais ce que tu fais.
DB_PATH=/app/data/heist.db

# ── Médias (fichiers audio des briefings) ─────────────────────
MEDIA_PATH=/app/media

# ── Durée de session joueur ───────────────────────────────────
# En heures. Par défaut : 12h (une journée de jeu).
ACCESS_TOKEN_EXPIRE_HOURS=12

# ── CORS (Cross-Origin Resource Sharing) ─────────────────────
# Origines autorisées à appeler l'API, séparées par des virgules.
# En développement : http://localhost:5173 (Vite dev server)
# En production : ton domaine réel (ex: https://heist.example.com)
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
